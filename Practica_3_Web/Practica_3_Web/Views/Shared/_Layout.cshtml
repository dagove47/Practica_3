<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Practica_3_Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Practica_3_Web.styles.css" asp-append-version="true" />
</head>
<body class="min-vh-100 d-flex flex-column m-0" style="background-color:#F9F9F9;">

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand me-5" asp-area="" asp-controller="Compra" asp-action="Index">¡Bienvenido!</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-end">
                        <li>@Html.ActionLink("Inicio", "Index", "Compra", new { area = "" }, new { @class = "nav-link ms-5" })</li>
                        <li>@Html.ActionLink("Consultar", "Consulta", "Compra", new { area = "" }, new { @class = "nav-link ms-3" })</li>
                        <li>@Html.ActionLink("Registrar", "Registro", "Compra", new { area = "" }, new { @class = "nav-link ms-3" })</li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container body-content flex-grow-1 d-flex justify-content-center">
        @RenderBody()
        <hr />
    </main>
    
    <footer class="bg-dark text-white py-4 mt-auto">
        <p class="text-center mb-0">&copy; @DateTime.Now.Year - Grupo 4</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
