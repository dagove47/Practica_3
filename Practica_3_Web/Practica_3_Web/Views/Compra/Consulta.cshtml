@{
    ViewData["Title"] = "Consulta";
    var listaCompras = ViewBag.ListaCompras as List<CompraModel>;
}

<section class="mt-5">
    <h2 class="mb-5 text-center">Consulta</h2>
    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Mensaje</div>
    }
    <table class="table table-striped">
        <thead>
            <tr class="bg-dark text-white">
                <th scope="col">Código de Compra</th>
                <th scope="col">Descripción</th>
                <th scope="col">Precio</th>
                <th scope="col">Saldo</th>
                <th scope="col">Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (listaCompras != null && listaCompras.Any())
            {
                @foreach (var item in listaCompras)
                {
                    <tr>
                        <td>@item.Id_Compra</td>
                        <td>@item.Descripcion</td>
                        <td>₡ @item.Precio</td>
                        <td>₡ @item.Saldo</td>
                        <td>@item.Estado</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No hay compras registradas.</td>
                </tr>
            }
        </tbody>
    </table>
</section>